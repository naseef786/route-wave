# ==============================================================================
# Route Wave General Transport - Environment Configuration Template
# Copy this file to .env.local for local development.
# In production, set these variables in your hosting provider (e.g. Vercel Dashboard).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Site & Domain Configuration
# ------------------------------------------------------------------------------
# Candidate production domain: https://routewave.ae
# In local development: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Email Delivery Configuration
# ------------------------------------------------------------------------------
# Internal business recipient mailbox where customer quotations are received.
# Default is info@routewave.ae.
CONTACT_TO_EMAIL=info@routewave.ae

# --- OPTION A: Tasjeel / Outlook Direct SMTP (Recommended - No third party needed) ---
# If your email is hosted on Tasjeel (cPanel / Webmail / Microsoft 365):
# SMTP_HOST=mail.routewave.ae
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=info@routewave.ae
# SMTP_PASS=YourEmailPasswordHere
# CONTACT_FROM_EMAIL=Route Wave Website <info@routewave.ae>

# --- OPTION B: Resend Cloud API ---
# Resend API Key (starts with "re_...")
# RESEND_API_KEY=
# CONTACT_FROM_EMAIL=Route Wave Notifications <notifications@routewave.ae>

# ------------------------------------------------------------------------------
# 3. Spam Protection (Cloudflare Turnstile)
# ------------------------------------------------------------------------------
# Cloudflare Turnstile public site key.
# For local development testing, Cloudflare provides "Always Pass" test keys:
# Site Key: 1x00000000000000000000AA
# Secret Key: 1x00000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x00000000000000000000000000000000AA

# ------------------------------------------------------------------------------
# 4. Optional Public Contact Channels (Omitted until formally approved)
# ------------------------------------------------------------------------------
# Leave blank during development. The UI automatically omits unconfigured elements.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_PHONE_DISPLAY=
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_CONTACT_WHATSAPP_DISPLAY=
